# Copy to .env for local dev. Staging/prod read these from Secret Manager.
ENV=local

# Local bootstrap uses sqlite; staging/prod use Postgres (Cloud SQL), @localhost host form:
#   DATABASE_URL=postgresql+psycopg://opshub:PASSWORD@localhost/opshub_prod?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=sqlite:///./opshub_local.db

# Firebase Auth (email/password). Locally, point at a service-account JSON;
# on Cloud Run, GOOGLE_APPLICATION_CREDENTIALS / ADC is used instead.
# FIREBASE_CREDENTIALS_FILE=./firebase-sa.json
# FIREBASE_PROJECT_ID=gifsy-opshub
