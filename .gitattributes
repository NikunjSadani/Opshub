# Binary assets must never receive text/EOL normalization — CRLF<->LF conversion
# would corrupt them (e.g. a committed PDF fixture read by the e2e suite on Linux CI).
*.pdf  binary
*.xlsx binary
*.xls  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.zip  binary
*.woff binary
*.woff2 binary
