# Python
__pycache__/
*.py[cod]
.venv/
*.db
.env
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
dist/
.vite/

# Secrets / creds
firebase-sa.json
*-sa.json
*.pem

# Terraform (keep .terraform.lock.hcl committed)
**/.terraform/*
*.tfstate
*.tfstate.*
terraform.tfvars

# OS
.DS_Store
Thumbs.db

# Local blob storage (LocalStorage FILES_DIR) + sqlite WAL
_files/
backend/_files/
*.db-wal
*.db-shm

# Playwright E2E (artifacts + generated fixtures)
frontend/test-results/
frontend/playwright-report/
# Ignore generated fixtures (template.xlsx is written by global-setup.ts at run time)
# and any stray artifacts, but TRACK the static invoice PDF the billing/expense specs
# read — it isn't generated, so CI needs it committed (else 6 e2e tests ENOENT).
frontend/e2e/fixtures/*
!frontend/e2e/fixtures/expense-invoice.pdf
